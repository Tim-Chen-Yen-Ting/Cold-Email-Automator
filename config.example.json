{
  "sender": {
    "name": "YOUR_FULL_NAME",
    "email": "YOUR_GMAIL_ADDRESS",
    "role": "YOUR_ROLE_OR_TITLE",
    "company": "YOUR_COMPANY_OR_PROJECT",
    "pitch": "ONE_SENTENCE_VALUE_PROP",
    "website": "YOUR_WEBSITE_OR_LINKEDIN",
    "signature": "Best,\nYOUR_NAME\nYOUR_TITLE | YOUR_COMPANY\nYOUR_WEBSITE"
  },
  "targeting": {

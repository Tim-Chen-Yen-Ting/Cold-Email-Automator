# Copy this file to .env and fill in your values

# --- AI Provider (set whichever you use) ---
# Anthropic Claude (default, best for research — native web search)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (set "provider": "openai" in config.json)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (set "provider": "gemini" in config.json)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Email Verification ---
REOON_API_KEY=your_reoon_api_key_here

# --- Gmail OAuth (generated by running: python setup_gmail.py) ---
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# --- Local proxy (optional) ---
# Only needed if Google's API servers aren't directly reachable on your network and you
# route through a local proxy (e.g. a VPN client). httplib2 (used for Gmail/Sheets calls
# only) doesn't pick up the system proxy automatically, so set this explicitly if needed.
# Deliberately not named HTTP_PROXY/HTTPS_PROXY — those generic names would also reroute
# unrelated traffic (e.g. OpenAI calls via httpx) through the same proxy.
# GOOGLE_API_PROXY=http://127.0.0.1:PORT
